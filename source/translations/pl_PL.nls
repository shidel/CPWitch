      <statBar>
        <Processing Caption="Przetwarzanie"/>
        <LineEnding CR="CR" LF="LF" CRLF="CRLF"/>
        <Codepage Caption="Strona kodowa"/>
        <Error Caption="Błąd"/>
        <Unicode Caption="Unicode"/>
        <NoEncoding Caption="ASCII"/>
        <Binary Caption="Binarny"/>
        <Percentage Format="%s%%" />
      </statBar>
      <ExportUnicodeDialog>
        <Title Caption="Eksportuj plik jako UTF-8"/>
        <File Filters="Wszystkie pliki (*.*)|*.*|Pliki Unicode (*.UTF-8)|*.UTF-8"/>
      </ExportUnicodeDialog>
      <OpenFilesDialog>
        <Title Caption="Otwórz istniejące pliki"/>
        <File Filters="Wszystkie pliki (*.*)|*.*|Pliki Unicode (*.UTF-8)|*.UTF-8"/>
      </OpenFilesDialog>
      <ExportCodepageDialog>
        <Title Caption="Eksportuj plik w stronie kodowej %s"/>
        <File Filters="Wszystkie pliki (*.*)|*.*"/>
      </ExportCodepageDialog>
      <ExportASCIIDialog>
        <Title Caption="Zapisz plik jako prosty 7-bitowy ASCII"/>
        <File Filters="Wszystkie pliki (*.*)|*.*"/>
      </ExportASCIIDialog>
    </fMain>
    <fDictEditForm Caption="Aktualizacja słownika">
      <pTop>
        <cbLocale Hint="Język słów dodawanych do słownika."/>
        <lbLocale Hint="Wybierz język słów dodawanych do słownika." Caption="Język:"/>
        <btnInvert Hint="Odwraca zaznaczenie wszystkich słów." Caption="Odwróć"/>
        <btnNone Hint="Usuwa zaznaczenie wszystkich słów." Caption="Żadne"/>
      </pTop>
      <pButtons>
        <btnSave Hint="Zapisuje zmiany w słowniku." Caption="Zapisz"/>
        <btnReload Hint="Wczytuje słownik ponownie i porzuca niezapisane zmiany." Caption="Odśwież"/>
        <btnAdd Hint="Dodaje zaznaczone słowa do słownika wybranego języka." Caption="Dodaj do słownika"/>
        <btnMerge Hint="Scala słowa ze słownika użytkownika ze słownikiem głównym." Caption="Scal"/>
      </pButtons>
      <Not_Avail Text="nd."/>
      <Any_Locale Text="(dowolny język)"/>
      <Unknown_Locale Text="(nieznany język)"/>
    </fDictEditForm>
    <fOptionsDialog Caption="Preferencje programu Codepage Witch">
      <pPages>
        <tsAbout Hint="Informacje o programie." Caption="Informacje">
          <lbCopyright Caption="Copyright %s"/>
          <lbVersion Caption="Wersja %0:s (kompilacja %1:s)"/>
          <lbApplication Caption="&quot;%s&quot;"/>
        </tsAbout>
        <tsGeneral Hint="Ogólne ustawienia programu." Caption="Ogólne">
          <gbUserLanguage Caption="Język interfejsu">
            <cxLanguageChoice Default="(domyślny)"/>
            <pLanguagePreferred>
              <lbLanguagePreferred Caption="Preferowany język:"/>
            </pLanguagePreferred>
            <lbLanguageSystem Caption="Język systemu:  %s"/>
          </gbUserLanguage>
          <gbMiscellaneous Caption="Różne">
            <cbShowHints Caption="Pokazuj podpowiedzi."/>
            <cbColorButtons Caption="Kolorowe przyciski na pasku narzędzi."/>
          </gbMiscellaneous>
          <gbOnlineUpdate Caption="Aktualizacja online">
            <cbAutoCheck Caption="Automatycznie sprawdzaj aktualizacje"/>
            <pUpdateButton>
              <btnUpdateCheck Hint="Sprawdza na serwerze, czy jest nowsza wersja." Caption="Sprawdź teraz..."/>
            </pUpdateButton>
          </gbOnlineUpdate>
        </tsGeneral>
        <tsSession Hint="Opcje sesji programu." Caption="Sesja">
          <gbSessionFiles Caption="Pliki sesji">
            <cbReopenFiles Hint="Otwiera ponownie pliki niezamknięte w poprzedniej sesji." Caption="Otwieraj ponownie poprzednie pliki."/>
            <cbWarnMissing Hint="Ostrzega, gdy plik z poprzedniej sesji nie istnieje." Caption="Ostrzegaj o brakujących plikach."/>
            <cbOpenExport Hint="Automatycznie otwiera wyeksportowane pliki do przejrzenia." Caption="Otwieraj wyeksportowane pliki."/>
          </gbSessionFiles>
          <gbLocaleDetection Caption="Wykrywanie języka">
            <cbUseFileExt Hint="W miarę możliwości przedkłada rozszerzenie pliku nad heurystykę językową." Caption="Preferuj rozszerzenie pliku"/>
          </gbLocaleDetection>
          <gbCodepage Caption="Strona kodowa">
            <cbAutoSelectCP Hint="Automatycznie wybiera preferowaną stronę kodową do konwersji." Caption="Automatyczny wybór strony kodowej"/>
          </gbCodepage>
        </tsSession>
        <tsTextEditor Hint="Opcje edytora tekstu." Caption="Edytor tekstu">
          <gbExternalEditor Caption="Edytor zewnętrzny">
            <cbUseExternalEditor Hint="Używa zewnętrznego edytora tekstu zamiast prostego edytora wbudowanego." Caption="Używaj zewnętrznego edytora tekstu"/>
            <pEditor>
              <btnBrowseEditor Hint="Wskazuje zewnętrzny edytor tekstu." Caption="Przeglądaj"/>
            </pEditor>
            <BrowseDialog Caption="Wybierz zewnętrzny edytor tekstu">
              <Title Caption="Wybierz zewnętrzny edytor tekstu"/>
              <File>
                <Unix Exec="Wszystkie pliki|*"/>
                <Windows Exec="Pliki wykonywalne|*.EXE|Wszystkie pliki|*.*"/>
              </File>
            </BrowseDialog>
          </gbExternalEditor>
        </tsTextEditor>
        <tsEncoding Hint="Opcje kodowania plików wejściowych i wyjściowych." Caption="Kodowanie">
          <rgFileEnding Hint="Wymaga, aby pliki kończyły się pustą linią." Caption="Nowa linia na końcu pliku">
            <rbFileEndWhatever Hint="Pliki mogą kończyć się tekstem lub pustą linią." Caption="Bez znaczenia."/>
            <rbFileEndExport Hint="Pilnuje, aby wyeksportowane pliki kończyły się pustą linią." Caption="Tylko przy eksporcie."/>
            <rbFileEndAll Hint="Wymaga, aby oryginalne pliki kończyły się pustą linią." Caption="Wymagaj we wszystkich plikach tekstowych."/>
          </rgFileEnding>
        </tsEncoding>
        <tsViewer Hint="Opcje podglądu Unicode i DOS." Caption="Podgląd">
          <gbUnicodeView Caption="Podgląd Unicode">
            <tbUnicodeScale Caption="10"/>
            <lbScaleOfUnicode Caption="Skala czcionki %s%%"/>
          </gbUnicodeView>
          <gbDOSView Caption="Podgląd DOS">
            <tbDOSScale Caption="1"/>
            <lbDOSScale Caption="Skala czcionki %s%%"/>
          </gbDOSView>
          <gbViewers Caption="Podglądy">
            <cbSingleViewer Hint="Pokazuje w oknie głównym tylko jeden panel podglądu pliku." Caption="Tryb pojedynczego podglądu"/>
          </gbViewers>
        </tsViewer>
      </pPages>
      <fLowerPanel>
        <fButtonPanel>
          <btnAccept Hint="Akceptuje i stosuje zmiany." Caption="Akceptuj"/>
          <btnCancel Hint="Odrzuca wszystkie zmiany." Caption="Anuluj"/>
        </fButtonPanel>
      </fLowerPanel>
      <fMiddlePanel>
        <fBodyPanel>
          <pSectionsPanel>
            <pSectionLabel>
              <lbSections Caption="Opcje"/>
            </pSectionLabel>
          </pSectionsPanel>
        </fBodyPanel>
      </fMiddlePanel>
    </fOptionsDialog>
    <fMissingFiles Caption="Brakujące pliki dokumentów">
      <fLowerPanel>
        <fButtonPanel>
          <btnCancel Caption="Anuluj"/>
        </fButtonPanel>
      </fLowerPanel>
    </fMissingFiles>
    <fUpdateCheckDialog Caption="Sprawdzanie aktualizacji">
      <fLowerPanel>
        <fButtonPanel>
          <btnCancel Caption="Anuluj"/>
          <btnRetry Caption="Ponów próbę"/>
        </fButtonPanel>
      </fLowerPanel>
      <Message>
        <Check Text="Sprawdzanie dostępnych aktualizacji programu &quot;%s&quot;, wersja %s."/>
        <Error Text="Nie można teraz ustalić, czy są aktualizacje programu &quot;%s&quot;. Spróbuj ponownie później."/>
        <None Text="Obecnie brak aktualizacji programu &quot;%s&quot;. Spróbuj ponownie później."/>
      </Message>
    </fUpdateCheckDialog>
    <fUpdateFoundDialog Caption="Dostępna aktualizacja">
      <fLowerPanel>
        <fButtonPanel>
          <btnCancel Caption="Anuluj"/>
          <btnDownload Caption="Pobierz"/>
          <btnSkip Caption="Pomiń"/>
        </fButtonPanel>
        <fAuxPanel>
          <cbSkipVersion Caption="Pomiń tę wersję"/>
        </fAuxPanel>
      </fLowerPanel>
      <Message>
        <Note Text="Brak informacji o wydaniu dla wersji %1:s programu &quot;%0:s&quot;"/>
      </Message>
    </fUpdateFoundDialog>
    <fUpdateDownloadDialog Caption="Pobieranie aktualizacji">
      <fLowerPanel>
        <fButtonPanel>
          <btnCancel Caption="Anuluj"/>
          <btnRetry Caption="Ponów próbę"/>
        </fButtonPanel>
      </fLowerPanel>
      <Message>
        <Fetch Text="Pobieranie aktualizacji programu &quot;%s&quot;."/>
        <Error Text="Błąd pobierania aktualizacji programu &quot;%s&quot;. Spróbuj ponownie później."/>
      </Message>
    </fUpdateDownloadDialog>
    <fUpdateSaveDialog Caption="Pobrano aktualizację">
      <fLowerPanel>
        <fButtonPanel>
          <btnCancel Caption="Anuluj"/>
          <btnSaveAs Caption="Zapisz jako..."/>
        </fButtonPanel>
      </fLowerPanel>
      <Message>
        <Downloaded Text="Pobrano &quot;%s&quot; w wersji %s."/>
      </Message>
      <SaveAsDialog>
        <Title Caption="Zapisz aktualizację jako"/>
        <File Filters="Archiwa (*.zip)|*.log|Wszystkie pliki (*.*)|*.*"/>
      </SaveAsDialog>
    </fUpdateSaveDialog>
    <fLoggerViewForm Caption="Dziennik debugowania">
      <LineCount Plural="Wpisy w dzienniku: %.0n" Singular="Wpisy w dzienniku: %.0n"/>
      <pControls>
        <pButtons>
          <btnClear Hint="Czyści bieżący dziennik debugowania." Caption="Wyczyść"/>
          <btnSaveAs Hint="Zapisuje dziennik debugowania do pliku." Caption="Zapisz jako..."/>
        </pButtons>
        <pVerbose>
          <cbVerbosity Hint="Wybierz szczegółowość i liczbę komunikatów dziennika debugowania. Uwaga: może to zużyć dużo pamięci i znacznie spowolnić program.">
            <Items Index_0="Krytyczne" Index_1="Minimalne" Index_2="Normalne" Index_3="Szczegółowe" Index_4="Nadmiarowe"/>
          </cbVerbosity>
          <lbVerbosity Caption="Szczegółowość:"/>
        </pVerbose>
      </pControls>
      <SaveAsDialog>
        <Title Caption="Zapisz dziennik debugowania jako"/>
        <File Filters="Pliki dziennika (*.log)|*.log|Wszystkie pliki (*.*)|*.*"/>
      </SaveAsDialog>
    </fLoggerViewForm>
    <fDiffLocaleDialog Caption="Niezgodny język">
      <fLowerPanel>
        <fButtonPanel>
          <btnProceed Caption="Kontynuuj"/>
          <btnCancel Caption="Anuluj"/>
        </fButtonPanel>
      </fLowerPanel>
      <Message Text="Oczekiwany język tego pliku to %s.&#xA;&#xA;Czy na pewno dodać słowa do słownika języka %s?"/>
    </fDiffLocaleDialog>
    <fCorrectFileEndingDialog Caption="Brak końcowego znaku nowej linii">
      <fLowerPanel>
        <fButtonPanel>
          <btnCorrect Caption="Popraw"/>
          <btnIgnore Caption="Ignoruj"/>
        </fButtonPanel>
      </fLowerPanel>
      <Message Text="Plik &quot;%s&quot; nie kończy się pustą linią.&#xA;&#xA;Czy poprawić to, dodając znak nowej linii na końcu pliku?"/>
    </fCorrectFileEndingDialog>
    <fFileEditor Caption="Codepage Witch - %s">
      <btnCancel Caption="Anuluj"/>
      <btnSave Caption="Zapisz"/>
      <dlgSaveAs Title="Błąd zapisu pliku, zapisz plik jako"/>
    </fFileEditor>
  </Controls>
</CONFIG>
