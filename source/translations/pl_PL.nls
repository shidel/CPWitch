<?xml version="1.0" encoding="utf-8"?>
<CONFIG Language="pl_PL">
  <Translation>
    <Revision_0 Date="2026-10-11" Contributor="Piotr Okrutny"/>
  </Translation>
  <Application>
    <ModalButtons>
      <Ok Value="OK"/>
      <Cancel Value="Anuluj"/>
      <Yes Value="Tak"/>
      <No Value="Nie"/>
      <Close Value="Zamknij"/>
      <Abort Value="Przerwij"/>
      <Retry Value="Ponów próbę"/>
      <Ignore Value="Ignoruj"/>
      <All Value="Wszystkie"/>
      <NoToAll Value="Nie na wszystkie"/>
      <YesToAll Value="Tak na wszystkie"/>
    </ModalButtons>
    <Error>
      <File>
        <Read>
          <Caption Value="Błąd odczytu pliku"/>
          <Message Value="Podczas odczytu pliku &quot;%0:s&quot; wystąpił błąd nr %1:s (%2:s)."/>
        </Read>
        <Write>
          <Caption Value="Błąd zapisu pliku"/>
          <Message Value="Podczas zapisu do pliku &quot;%0:s&quot; wystąpił błąd nr %1:s (%2:s)."/>
        </Write>
      </File>
      <Codes>
        <ecUnknown Value="Nieznany błąd."/>
        <ec0 Value="Brak błędu"/>
        <ec2 Value="Nie znaleziono pliku"/>
        <ec3 Value="Nie znaleziono ścieżki"/>
        <ec4 Value="Za dużo otwartych plików"/>
        <ec5 Value="Odmowa dostępu"/>
        <ec6 Value="Nieprawidłowy uchwyt pliku"/>
        <ec12 Value="Nieprawidłowy tryb dostępu"/>
        <ec17 Value="Nie można zmienić nazwy między urządzeniami"/>
        <ec100 Value="Błąd odczytu dysku"/>
        <ec101 Value="Błąd zapisu dysku"/>
        <ec102 Value="Plik nie został przypisany"/>
        <ec103 Value="Plik nie jest otwarty"/>
        <ec104 Value="Plik nie jest otwarty do odczytu"/>
        <ec105 Value="Plik nie jest otwarty do zapisu"/>
        <ec106 Value="Nieprawidłowy format liczby"/>
        <ec150 Value="Dysk jest zabezpieczony przed zapisem"/>
      </Codes>
    </Error>
    <FormatSettings>
      <CurrencyFormat Value="3"/>
      <NegCurrFormat Value="8"/>
      <DecimalSeparator Value=","/>
      <CurrencyDecimals Value="2"/>
      <DateSeparator Value="."/>
      <TimeSeparator Value=":"/>
      <ListSeparator Value=";"/>
      <CurrencyString Value="zł"/>
      <ShortDateFormat Value="dd.mm.yyyy"/>
      <LongDateFormat Value="d&quot; &quot;mmmm&quot; &quot;yyyy"/>
      <TimeAMString Value=""/>
      <TimePMString Value=""/>
      <ShortTimeFormat Value="hh:nn"/>
      <LongTimeFormat Value="hh:nn:ss"/>
      <ShortMonthNames>
        <Index_1 Value="sty"/>
        <Index_2 Value="lut"/>
        <Index_3 Value="mar"/>
        <Index_4 Value="kwi"/>
        <Index_5 Value="maj"/>
        <Index_6 Value="cze"/>
        <Index_7 Value="lip"/>
        <Index_8 Value="sie"/>
        <Index_9 Value="wrz"/>
        <Index_10 Value="paź"/>
        <Index_11 Value="lis"/>
        <Index_12 Value="gru"/>
      </ShortMonthNames>
      <LongMonthNames>
        <Index_1 Value="stycznia"/>
        <Index_2 Value="lutego"/>
        <Index_3 Value="marca"/>
        <Index_4 Value="kwietnia"/>
        <Index_5 Value="maja"/>
        <Index_6 Value="czerwca"/>
        <Index_7 Value="lipca"/>
        <Index_8 Value="sierpnia"/>
        <Index_9 Value="września"/>
        <Index_10 Value="października"/>
        <Index_11 Value="listopada"/>
        <Index_12 Value="grudnia"/>
      </LongMonthNames>
      <ShortDayNames>
        <Index_1 Value="niedz."/>
        <Index_2 Value="pon."/>
        <Index_3 Value="wt."/>
        <Index_4 Value="śr."/>
        <Index_5 Value="czw."/>
        <Index_6 Value="pt."/>
        <Index_7 Value="sob."/>
      </ShortDayNames>
      <LongDayNames>
        <Index_1 Value="niedziela"/>
        <Index_2 Value="poniedziałek"/>
        <Index_3 Value="wtorek"/>
        <Index_4 Value="środa"/>
        <Index_5 Value="czwartek"/>
        <Index_6 Value="piątek"/>
        <Index_7 Value="sobota"/>
      </LongDayNames>
      <TwoDigitYearCenturyWindow Value="50"/>
    </FormatSettings>
  </Application>
  <Controls>
    <fMain Caption="Codepage Witch">
      <alMain>
        <actOpen Hint="Otwiera plik tekstowy." Caption="Otwórz plik..."/>
        <actPreferences Hint="Wyświetla lub zmienia preferencje programu Codepage Witch." Caption="Preferencje..."/>
        <actOnlineUpdate Hint="Sprawdza, czy są aktualizacje programu Codepage Witch." Caption="Sprawdź aktualizacje..."/>
        <actDebugLog Hint="Wyświetla dziennik debugowania." Caption="Dziennik debugowania..."/>
        <actListAll Hint="Wyświetla wszystkie znane strony kodowe." Caption="Wszystkie znane"/>
        <actListPartial Hint="Wyświetla strony kodowe zgodne częściowo." Caption="Wszystkie możliwe"/>
        <actListCompatible Hint="Wyświetla tylko strony kodowe w pełni zgodne." Caption="Tylko zgodne"/>
        <actCodepageFilter Hint="Filtruje listę stron kodowych." Caption="Filtr stron kodowych"/>
        <actExportASCII Hint="Eksportuje plik tekstowy jako 7-bitowy ASCII, który nie wymaga żadnej strony kodowej ani znaków Unicode." Caption="Eksportuj ASCII..."/>
        <actExportCodepage Hint="Eksportuje plik tekstowy zakodowany w stronie kodowej." Caption="Eksportuj w stronie kodowej..."/>
        <actExportUnicode Hint="Eksportuje plik tekstowy zakodowany w UTF-8." Caption="Eksportuj UTF-8..."/>
        <actEditASCII Hint="Edytuje prosty plik 7-bitowy ASCII." Caption="Edytuj ASCII..."/>
        <actEditCodepage Hint="Edytuje plik w stronie kodowej." Caption="Edytuj w stronie kodowej..."/>
        <actEditUnicode Hint="Edytuje plik tekstowy Unicode." Caption="Edytuj Unicode..."/>
        <actExportNone Hint="Nie można eksportować tego typu pliku." Caption="Brak eksportu"/>
        <actClose Hint="Zamyka bieżący plik tekstowy." Caption="Zamknij plik"/>
        <actCloseAll Hint="Zamyka wszystkie otwarte pliki tekstowe." Caption="Zamknij wszystkie"/>
        <actEditNone Hint="Nie można edytować tego typu pliku." Caption="Brak edytora"/>
        <actDictionary Hint="Otwiera edytor słownika użytkownika." Caption="Słownik..."/>
      </alMain>
      <pBody>
        <pFileList>
          <pFileListLabel>
            <lbFileList Caption="Pliki tekstowe"/>
          </pFileListLabel>
        </pFileList>
        <pCodepageList>
          <pCodepageListLabel>
            <lbCodepageLabel Caption="Strony kodowe"/>
          </pCodepageListLabel>
          <lvCodepageList>
            <Analyzing Caption="Analizowanie"/>
            <Error Caption="Błąd"/>
            <Not_implemented Caption="Nie zaimplementowano"/>
            <Any_Codepage Caption="Dowolna strona kodowa"/>
            <Binary_data Caption="Plik binarny"/>
          </lvCodepageList>
        </pCodepageList>
        <pViewers>
          <pViewUnicode>
            <pViewUnicodeLabel>
              <lbUnicodeViewLabel Caption="Podgląd jako Unicode"/>
            </pViewUnicodeLabel>
            <File_Error>
              <Error Text="Wystąpił błąd pliku lub przetwarzania."/>
            </File_Error>
            <Unsupported_file>
              <Binary Text="Pliki z danymi binarnymi nie są obsługiwane."/>
            </Unsupported_file>
          </pViewUnicode>
          <pCodepage>
            <pViewCodepageLabel>
              <lbViewCodepageLabel Value="Podgląd w stronie kodowej %s"/>
            </pViewCodepageLabel>
          </pCodepage>
        </pViewers>
      </pBody>
      <Locales>
